#!/usr/bin/env python3
"""Export a Diaphora database for each of the given files."""

import argparse

import r2diaphora
from r2diaphora.diaphora_r2 import DECOMPILERS

parser = argparse.ArgumentParser(
    description="Export Diaphora 3.5 databases with radare2."
)
parser.add_argument("files", nargs="+", help="Files to analyze")
parser.add_argument(
    "-f",
    dest="force_db_override",
    action="store_true",
    help="Force DB override",
)
parser.add_argument(
    "-a",
    dest="analyze_all",
    action="store_true",
    help="Analyze ALL functions (by default library functions are skipped)",
)
parser.add_argument(
    "-nbbs",
    dest="nbbs",
    default=0,
    type=int,
    help="Exclude functions with fewer than this number of basic blocks",
)
parser.add_argument(
    "-d",
    "--decompiler",
    default="ghidra",
    choices=sorted(DECOMPILERS),
    help="Which decompiler to use",
)
parser.add_argument(
    "-nd",
    "--no-decompiler",
    dest="no_decompiler",
    action="store_true",
    help="Do not use the decompiler",
)
parser.add_argument(
    "-t",
    "--timeout",
    default=None,
    type=int,
    help="Timeout, in seconds, for each radare2 invocation",
)
parser.add_argument(
    "--pdb",
    dest="load_pdb",
    action="store_true",
    help="Let radare2 load PDB symbols, when available",
)
parser.add_argument(
    "--db-backend",
    dest="backend",
    default="sqlite",
    choices=list(r2diaphora.db_backend.BACKENDS),
    help="Database backend to use (default: sqlite)",
)
parser.add_argument(
    "--db-dir",
    dest="db_dir",
    default=None,
    help="Directory holding SQLite databases (default: ~/.r2diaphora/dbs)",
)

args = parser.parse_args()

r2diaphora.configure_db_backend(args.backend, db_dir=args.db_dir)


def function_filter(info):
    if info["name"].startswith("flirt."):
        return False
    return info["nbbs"] >= args.nbbs


fn_filter = None if args.analyze_all else function_filter

for path in args.files:
    db_name = r2diaphora.generate_db_for_file(
        path,
        override_if_existing=args.force_db_override,
        function_filter=fn_filter,
        timeout=args.timeout,
        load_pdb=args.load_pdb,
        use_decompiler=not args.no_decompiler,
        decompiler=args.decompiler,
        analyze_all=args.analyze_all,
        backend=args.backend,
        db_dir=args.db_dir,
    )
    print(f"[+] {path} -> {db_name}")
